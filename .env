# ============================================================
# FILL IN the two values marked REQUIRED before running Docker
# Everything else is pre-configured for local Docker use
# ============================================================

# --- REQUIRED: Change this to any long random string ---
JWT_SECRET=my_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=1h

# --- REQUIRED: Your Stripe TEST secret key ---
# Get it from: https://dashboard.stripe.com/test/apikeys
# It starts with: sk_test_...
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_CURRENCY=usd

# --- Admin account (created automatically on first boot) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin

# --- MongoDB (pre-configured for Docker internal network) ---
# These point to the MongoDB containers inside Docker — do NOT change
MONGODB_URI=mongodb://auth-db:27017/auth-service
MOVIE_MONGO_URI=mongodb://movie-db:27017/movie-db
SHOW_MONGO_URI=mongodb://show-db:27017/show-db
PAYMENT_MONGO_URI=mongodb://payment-db:27017/payment-db

# --- Internal service key (must match across all services) ---
INTERNAL_SERVICE_KEY=ctse-internal-service-key-2026

# --- Frontend: URL the BROWSER uses to reach the API gateway ---
# For local Docker: keep as http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
