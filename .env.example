# =============================================================
# Online Movie Ticket Booking System — Environment Variables
# Copy this file to .env and fill in the values before running
# =============================================================

# ---------------- Auth Service ----------------
JWT_SECRET=change_me_use_a_long_random_string_in_production
JWT_EXPIRES_IN=1h

# Admin seed account (created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin

# Auth-service MongoDB (leave as-is for docker-compose local setup)
# Override with your Atlas URI for cloud:
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/auth-service
MONGODB_URI=mongodb://auth-db:27017/auth-service

# ---------------- Movie Service ----------------
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/movie-db
MOVIE_MONGO_URI=mongodb://movie-db:27017/movie-db
# Used to cancel ACTIVE shows when a movie is deleted (same key as show/payment/booking)
# INTERNAL_SERVICE_KEY=ctse-internal-service-key-2026

# ---------------- Show Service ----------------
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/show-db
SHOW_MONGO_URI=mongodb://show-db:27017/show-db

# Internal service-to-service key (must match across show, payment, and booking services)
INTERNAL_SERVICE_KEY=ctse-internal-service-key-2026

# Show service — validate JWT (same URL the browser uses is fine when port-forwarding)
AUTH_SERVICE_URL=http://localhost:5000

# Booking service — JWT validation for customer/admin reads; payment uses INTERNAL_SERVICE_KEY for writes
# AUTH_SERVICE_URL=http://localhost:5000

# Payment → booking-service (direct, not through gateway)
BOOKING_SERVICE_URL=http://localhost:4003

# ---------------- Payment Service ----------------
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/payment-db
PAYMENT_MONGO_URI=mongodb://payment-db:27017/payment-db

# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_CURRENCY=usd

# ---------------- Frontend ----------------
# URL the BROWSER uses to reach the API Gateway.
# For local docker-compose: http://localhost:3000
# For cloud deployment: https://your-gateway-domain
VITE_API_BASE_URL=http://localhost:3000
