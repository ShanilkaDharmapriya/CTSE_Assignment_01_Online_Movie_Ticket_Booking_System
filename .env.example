# =============================================================
# Online Movie Ticket Booking System — per-service .env
# Copy to each service folder as .env or inject via Docker Compose.
# =============================================================

# ---------------- Auth Service (auth-service/.env) ----------------
JWT_SECRET=change_me_use_a_long_random_string_in_production
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin
MONGO_URI=mongodb://auth-db:27017/auth-service

# ---------------- Movie Service (movie-service/.env) ----------------
# MONGO_URI=mongodb://movie-db:27017/movie-db
# SHOW_SERVICE_URL=http://show-service:4002
# AUTH_SERVICE_URL=http://auth-service:5000

# ---------------- Show Service (show-service/.env) ----------------
# MONGO_URI=mongodb://show-db:27017/show-db
INTERNAL_SERVICE_KEY=ctse-internal-service-key-2026
# MOVIE_SERVICE_URL=http://movie-service:4001
# AUTH_SERVICE_URL=http://auth-service:5000

# ---------------- Booking Service (booking-service/.env) ----------------
# MONGO_URI=mongodb://booking-db:27017/booking-db
# MOVIE_SERVICE_URL=http://movie-service:4001
# SHOW_SERVICE_URL=http://show-service:4002
# PAYMENT_SERVICE_URL=http://payment-service:4004
# AUTH_SERVICE_URL=http://auth-service:5000

# ---------------- Payment Service (payment-service/.env) ----------------
# MONGO_URI=mongodb://payment-db:27017/payment-db
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_CURRENCY=usd

# ---------------- API Gateway (api-gateway/.env) ----------------
# AUTH_SERVICE_URL=http://auth-service:5000
# MOVIE_SERVICE_URL=http://movie-service:4001
# SHOW_SERVICE_URL=http://show-service:4002
# BOOKING_SERVICE_URL=http://booking-service:4003
# PAYMENT_SERVICE_URL=http://payment-service:4004

# ---------------- Frontend (frontend/.env) — build-time ----------------
VITE_API_BASE_URL=http://localhost:3000
